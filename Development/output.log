346: # Compile-only Sequoia 24H32 controller ABI slice. This object is deliberately
347: # NOT linked into the legacy/bridge Kext: its IO80211Controller declaration has
348: # a different vtable ABI from the legacy header used by the active target.
349: WCL24H32_CONTROLLER_SRC := $(KEXT_SRC)/wcl24h32/RTW88WCLController.cpp
350: WCL24H32_CONTROLLER_OBJ := $(BUILD_DIR)/wcl24h32/RTW88WCLController.o
351: WCL24H32_INFRA_SRC := $(KEXT_SRC)/wcl24h32/RTW88WCLInfraInterface.cpp
352: WCL24H32_INFRA_OBJ := $(BUILD_DIR)/wcl24h32/RTW88WCLInfraInterface.o
