62:     uint32_t _stopping = 0;        // guarded by _lock
63:     uint32_t _registered = 0;      // lifecycle-owned
64:     uint32_t _dropped = 0;         // guarded by _lock
65:     uint32_t _coalescedRSSI = 0;    // guarded by _lock
66: };

