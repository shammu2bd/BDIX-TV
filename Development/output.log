565: {
566:     if (!super::init()) return false;
567:     _parent = delegate;
568:     _pcidev = pci;
569:     _lock    = IOLockAlloc();
570:     _bssLock = IOLockAlloc();
571:     if (!_lock || !_bssLock) return false;
572:     _joinFail.clear();
573:     _joinTried.clear();
574:     _baRecovery.reset();
575:     _connectTC = thread_call_allocate((thread_call_func_t)RTW88IEEE80211::connectTCFn,
576:                                        (thread_call_param_t)this);
577:     _manualScanTC = thread_call_allocate((thread_call_func_t)RTW88IEEE80211::manualScanTCFn,
578:                                          (thread_call_param_t)this);
579:     if (!_connectTC || !_manualScanTC) return false;
580:     /* Install callbacks into compat layer */
581:     static struct rtw88_hw_callbacks cbs = {
582:         .rx_frame  = RTW88IEEE80211::compat_rx_frame,
583:         .tx_status = RTW88IEEE80211::compat_tx_status,
584:         .scan_done = RTW88IEEE80211::compat_scan_done,
585:     };
586:     rtw88_set_hw_callbacks(&cbs, this);
587:     /* Set up workloop / timer for state machine */
588:     _wl = IOWorkLoop::workLoop();
589:     if (!_wl) return false;
590:     _gate = IOCommandGate::commandGate(this);
591:     if (!_gate) return false;
592:     if (_wl->addEventSource(_gate) != kIOReturnSuccess) return false;
593:     _timer = IOTimerEventSource::timerEventSource(this,
594:         &RTW88IEEE80211::timerFired);
595:     if (!_timer) return false;
596:     if (_wl->addEventSource(_timer) != kIOReturnSuccess) return false;
597:     /* RX A-MPDU reorder: lock + hole-flush timer.  The timer lives on the
598:      * RX/interrupt workloop (not _wl) so reorder-released frames and normal RX
599:      * frames are delivered from the same thread — injectRxFrame's queue+
600:      * flush is not safe against concurrent callers. */
601:     _rxBaLock = IOLockAlloc();
602:     if (!_rxBaLock) return false;
603:     IOWorkLoop *rxwl = _parent ? _parent->getRxWorkLoop() : nullptr;
604:     if (!rxwl) return false;
605:     _reorderTimer = IOTimerEventSource::timerEventSource(this,
606:         &RTW88IEEE80211::reorderTimerFired);
607:     if (!_reorderTimer) return false;
608:     if (rxwl->addEventSource(_reorderTimer) != kIOReturnSuccess) return false;
609:     IOLog("rtw88: RTW88IEEE80211 initialized\n");
610:     return true;
611: }
