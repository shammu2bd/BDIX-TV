372: .PHONY: rtl88wifi rtl88wifi-wcl-controller-abi-check wcl-abi-audit-24h32
373: rtl88wifi: $(AIRPORT_OUT_BIN) rtl88wifi-wcl-controller-abi-check
374: 
375: # Emit complete 24H32 registration/deregistration function bodies and their
376: # Apple call paths directly to stdout. The user can append this report to the
377: # one project-root output.log after the normal build for focused ABI review.
378: ABI_ARCHIVE ?= $(HOME)/Downloads/RTL88WiFi-Sequoia-24H32-kcabi.tar.gz
379: wcl-abi-audit-24h32:
380: 	@test -r "$(ABI_ARCHIVE)" || { echo "ERROR: ABI archive not readable: $(ABI_ARCHIVE)"; exit 2; }
381: 	@echo "  WCL-ABI AUDIT  Sequoia 24H32 registration and call paths"
382: 	python3 $(PROJ_ROOT)/../../tools/audit-skywalk-registration-24H32.py "$(ABI_ARCHIVE)" --full-registration-asm --stdout
383: 
384: # Compile the native Sequoia 24H32 controller/interface and ABI-neutral PCI
385: # owner independently. All objects stay out of AIRPORT_ALL_OBJS: the active
386: # Kext still includes the legacy IO80211Controller declaration and must not
387: # mix the incompatible ABI. The controller now owns the PCI backend and RTW88
388: # state-machine object in a staged, fail-closed lifecycle.
389: rtl88wifi-wcl-controller-abi-check: $(WCL24H32_CONTROLLER_OBJ) $(WCL24H32_INFRA_OBJ) $(WCL24H32_PCI_BACKEND_OBJ) $(WCL24H32_SKYWALK_QUEUES_OBJ) $(WCL24H32_TX_ADAPTER_OBJ) $(WCL24H32_RX_ADAPTER_OBJ)
