6: #pragma once
7: 
8: #include <stddef.h>
9: 
10: /* Single-owner ring: callers must provide external synchronization when the
11:  * producer and consumer can run concurrently. No allocation occurs after
12:  * construction, and enqueue/dequeue are O(1). */
13: template <typename T, size_t Capacity>
14: class RTW88WCLRadioEventRing final {
15:     static_assert(Capacity > 1, "event ring must have at least two slots");
16: 
17: public:
18:     bool push(const T &value)
19:     {
20:         if (_count == Capacity)
21:             return false;
22:         _items[_tail] = value;
23:         _tail = next(_tail);
24:         ++_count;
25:         return true;
26:     }
27: 
28:     bool pop(T *out)
29:     {
30:         if (!out || _count == 0)
31:             return false;
32:         *out = _items[_head];
33:         _head = next(_head);
34:         --_count;
35:         return true;
36:     }
