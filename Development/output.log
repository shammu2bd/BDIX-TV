325: # RTL88WiFi native IO80211 target. Its controller and interface sources
326: # live in src/kext/:
327: #   RTL88WiFi.hpp  RTL88WiFi.cpp
328: #   RTL88WiFiInterface.hpp  RTL88WiFiInterface.cpp
